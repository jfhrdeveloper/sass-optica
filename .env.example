# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# SOLO server-side / API routes / SQL Editor. NUNCA salir al cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ====== App / dominio ======
# Dominio raíz canónico (sin www). En local usa "localhost" — los subdominios
# de negocio se prueban como [slug].localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# URL pública del sitio (para construir redirectTo de invitación/reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====== Culqi (Fase 4 — pagos) ======
# Llave pública: la usa el Checkout embebido en el navegador → SÍ lleva
# NEXT_PUBLIC_. Llave secreta: SOLO server-side (crea el cargo, nunca al cliente).
# El monto del cargo NO es una variable de entorno: se recalcula en
# /api/pagos/culqi/cargo a partir del plan elegido (Básico/Premium, mensual/
# anual), usando src/lib/precios.ts como única fuente de precios.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# ====== PostHog (analítica — solo páginas públicas, nunca /dashboard) ======
# Cuenta gratis en https://posthog.com → Project Settings → Project API Key.
# Vacío = analítica desactivada (AnalyticsProvider no inicializa nada).
# Aunque esté configurada, solo se activa si el visitante acepta el banner de
# cookies — ver src/components/providers/AnalyticsProvider.tsx.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ====== Modo mock (TEMPORAL — ver src/lib/mock/mock-mode.ts) ======
# Deja en "false" (o quita la línea) salvo que quieras verificar el dashboard
# localmente sin un proyecto Supabase real. NUNCA activar en producción.
NEXT_PUBLIC_MOCK_MODE=false
